# Data directories and data files (Rule 8: Never commit raw/large datasets)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Catch-all for large survey and binary datasets
*.zip
*.tar.gz
*.xpt
*.XPT
data/**/*.csv
data/**/*.csv.gz
*.parquet
*.feather
*.pkl
*.joblib

# Models and checkpoints
models/*.pkl
models/*.joblib
models/*.onnx
models/*.pt
models/*.bin
!models/.gitkeep

# Operating System specific
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store

